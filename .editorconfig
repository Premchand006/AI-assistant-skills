root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4
max_line_length = 88

[*.{yml,yaml,json}]
indent_size = 2

[*.md]
indent_size = 2
# Two trailing spaces are a hard line break in Markdown.
trim_trailing_whitespace = false

[*.sh]
indent_size = 2

[Makefile]
indent_style = tab

[*.{v,sv,svh,vh}]
indent_size = 4

[*.{c,h}]
indent_size = 4
